PORT=8080
JWT_SECRET=your-secret-key-change-in-production
ENCRYPTION_KEY=your-32-char-hex-key-change-in-production

# PostgreSQL (omit to use SQLite locally)
DATABASE_URL=
DATABASE_PRIVATE_URL=

# Upstash Redis caching (optional, omit to disable)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Razorpay Gateway
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# PayU Gateway (Optional second gateway)
PAYU_MERCHANT_KEY=your_payu_merchant_key
PAYU_MERCHANT_SALT=your_payu_merchant_salt
PAYU_MODE=test # or production